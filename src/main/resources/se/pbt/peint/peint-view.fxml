<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="se.pbt.peint.controller.PeintController">
    <!-- Menu bar (always at the top) + the small toolbar it sits above -->
    <top>
        <VBox fx:id="topContainer">
            <MenuBar>
                <!-- File: save/open a whole image file -->
                <Menu text="File">
                    <MenuItem text="Save" onAction="#onSave">
                        <graphic>
                            <FontIcon iconLiteral="fas-save" iconSize="16" />
                        </graphic>
                    </MenuItem>
                    <MenuItem text="Open" onAction="#onLoad">
                        <graphic>
                            <FontIcon iconLiteral="fas-folder-open" iconSize="16" />
                        </graphic>
                    </MenuItem>
                </Menu>
                <!-- Edit: canvas history, not drawing tools themselves -->
                <Menu text="Edit">
                    <MenuItem text="Undo" onAction="#onUndo">
                        <graphic>
                            <FontIcon iconLiteral="fas-undo" iconSize="16" />
                        </graphic>
                    </MenuItem>
                    <MenuItem text="Redo" onAction="#onRedo">
                        <graphic>
                            <FontIcon iconLiteral="fas-redo" iconSize="16" />
                        </graphic>
                    </MenuItem>
                    <MenuItem text="Clear" onAction="#onClearCanvas">
                        <graphic>
                            <FontIcon iconLiteral="fas-eraser" iconSize="16" />
                        </graphic>
                    </MenuItem>
                </Menu>
                <!-- Draw: drawing tools -->
                <Menu text="Draw">
                    <MenuItem text="Fill" onAction="#onBucketFill">
                        <graphic>
                            <FontIcon iconLiteral="fas-fill-drip" iconSize="16" />
                        </graphic>
                    </MenuItem>
                </Menu>
            </MenuBar>

            <!-- Coloring + toolbar positioning: the only controls not moved into the menu bar -->
            <ToolBar fx:id="toolBar">
                <ColorPicker fx:id="colorPicker">
                    <tooltip>
                        <Tooltip text="Select a color for drawing" />
                    </tooltip>
                </ColorPicker>
                <Button onAction="#onToggleToolbarPosition">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrows-alt" iconSize="16" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Toggle toolbar position" />
                    </tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <!-- Canvas -->
    <center>
        <Canvas fx:id="canvas" width="800" height="600" />
    </center>
</BorderPane>