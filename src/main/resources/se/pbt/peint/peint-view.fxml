<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.layout.Pane?>
<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="se.pbt.peint.controller.PeintController">
    <!-- Menu bar (always at the top) + the small toolbar it sits above -->
    <top>
        <VBox fx:id="topContainer">
            <MenuBar>
                <!-- File: save/open a whole image file -->
                <Menu text="File">
                    <MenuItem text="Save" onAction="#onSave" accelerator="Shortcut+S">
                        <graphic>
                            <FontIcon iconLiteral="fas-save" iconSize="16" />
                        </graphic>
                    </MenuItem>
                    <MenuItem text="Open" onAction="#onLoad" accelerator="Shortcut+O">
                        <graphic>
                            <FontIcon iconLiteral="fas-folder-open" iconSize="16" />
                        </graphic>
                    </MenuItem>
                </Menu>
                <!-- Edit: canvas history, not drawing tools themselves -->
                <Menu text="Edit">
                    <MenuItem text="Undo" onAction="#onUndo" accelerator="Shortcut+Z">
                        <graphic>
                            <FontIcon iconLiteral="fas-undo" iconSize="16" />
                        </graphic>
                    </MenuItem>
                    <MenuItem text="Redo" onAction="#onRedo" accelerator="Shortcut+Y">
                        <graphic>
                            <FontIcon iconLiteral="fas-redo" iconSize="16" />
                        </graphic>
                    </MenuItem>
                    <MenuItem text="Clear" onAction="#onClearCanvas">
                        <graphic>
                            <FontIcon iconLiteral="fas-eraser" iconSize="16" />
                        </graphic>
                    </MenuItem>
                </Menu>
                <!-- Draw: drawing tools -->
                <Menu text="Draw">
                    <MenuItem text="Brush" onAction="#onBrush" accelerator="B">
                        <graphic>
                            <FontIcon iconLiteral="fas-paint-brush" iconSize="16" />
                        </graphic>
                    </MenuItem>
                    <MenuItem text="Fill" onAction="#onBucketFill" accelerator="F">
                        <graphic>
                            <FontIcon iconLiteral="fas-fill-drip" iconSize="16" />
                        </graphic>
                    </MenuItem>
                </Menu>
            </MenuBar>

            <!-- Tools, coloring and toolbar positioning -->
            <ToolBar fx:id="toolBar">
                <!-- One tool is always selected; the controller keeps the
                     group from being emptied by clicking the selected one. -->
                <ToggleButton fx:id="brushButton" onAction="#onBrush" selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="toolGroup" />
                    </toggleGroup>
                    <graphic>
                        <FontIcon iconLiteral="fas-paint-brush" iconSize="16" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Brush (B)" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="fillButton" onAction="#onBucketFill" toggleGroup="$toolGroup">
                    <graphic>
                        <FontIcon iconLiteral="fas-fill-drip" iconSize="16" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Fill (F)" />
                    </tooltip>
                </ToggleButton>
                <Separator />
                <ColorPicker fx:id="colorPicker">
                    <tooltip>
                        <Tooltip text="Select a color for drawing" />
                    </tooltip>
                </ColorPicker>
                <!-- Expanding spacer: pushes the button below to the far edge
                     (right when horizontal, bottom when vertical). ToolBar
                     honors both grow constraints even though it isn't
                     literally an HBox/VBox, so both are set unconditionally
                     rather than switched per orientation. -->
                <Region HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" />
                <Button fx:id="toggleToolbarPositionButton" onAction="#onToggleToolbarPosition">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrows-alt" iconSize="16" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Toggle toolbar position" />
                    </tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <!-- Canvas: wrapped in a plain Pane, since Canvas itself isn't resizable
        and BorderPane can't size it to the center region on its own.
        The Pane sits in a ScrollPane that stretches it to fill the window
        (fitToWidth/fitToHeight), but never below its minimum size. That
        minimum is its preferred size, i.e. the canvas's own size, so the Pane
        is as large as the window or the canvas, whichever is larger, and
        scroll bars appear once the canvas outgrows the window. -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <Pane fx:id="canvasContainer" minWidth="-Infinity" minHeight="-Infinity">
                <Canvas fx:id="canvas" />
            </Pane>
        </ScrollPane>
    </center>
</BorderPane>